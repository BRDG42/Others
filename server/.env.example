# BRDG · Photographer Spotlight — publisher config
# Copy to .env (or set these in your host's dashboard). NEVER commit real values.

# Instagram Business/Creator user id (numeric). From the Graph API:
#   GET /me/accounts -> page id ; GET /{page-id}?fields=instagram_business_account
IG_USER_ID=

# Long-lived / system-user access token with: instagram_basic,
# instagram_content_publish, pages_read_engagement, pages_show_list.
IG_ACCESS_TOKEN=

# Shared secret the PWA must send as the x-publish-secret header.
# Make it long and random, e.g.  openssl rand -hex 24
PUBLISH_SECRET=

# This service's own public HTTPS URL (Instagram fetches the images from here).
# e.g. https://brdg-spotlight.onrender.com   (no trailing slash)
PUBLIC_BASE_URL=

# --- optional ---
# Restrict who may call the API (your PWA origin). Default * allows any origin.
ALLOW_ORIGIN=https://brdg42.github.io
# Graph API version.
GRAPH_VERSION=v21.0
# Set to 1 to test the whole flow WITHOUT calling Instagram (returns fake ids).
IG_DRY_RUN=
# Port (most hosts set this for you).
PORT=8080
